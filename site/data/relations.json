{
 "about": "The map's one source: lanes, nodes and typed edges. An edge is a claim, so each names the file that makes it and the words that say so; the build refuses an edge whose words are gone. Positions across are dates the build reads, never typed here. lane, row and bend are layout only.",
 "lanes": ["DETERMINISM", "FILM & PHOTOGRAPHY", "PRESERVATION"],
 "kinds": [
  ["grew-into", "grew into"],
  ["extracted", "spun out"],
  ["built-on", "underlies"],
  ["ports", "hosts a port of"],
  ["verified-by", "verifies"],
  ["distilled-from", "was distilled into"]
 ],
 "nodes": [
  {"name": "PrettyCloud", "lane": 0, "row": 1},
  {"name": "atlas-engine", "lane": 0, "row": 0},
  {"name": "cft-fp256", "lane": 0, "row": 2, "trunk": true},
  {"name": "cft-rebound", "lane": 0, "row": 1},
  {"name": "ParcelRound", "lane": 0, "row": 0},
  {"name": "HonestFramework", "lane": 0, "row": 3},
  {"name": "CanonBracketTool", "lane": 1, "row": 0},
  {"name": "Microscope-Stacker", "lane": 1, "row": 2},
  {"name": "atlas-darkroom", "lane": 1, "row": 0},
  {"name": "atlas-optical", "lane": 1, "row": 1,
   "born": {"path": "README.md", "pattern": "Extracted whole from\\s+atlas-darkroom on (\\d{4}-\\d{2}-\\d{2})"}},
  {"name": "atlas-film", "lane": 1, "row": 2,
   "born": {"path": "README.md", "pattern": "Born (\\d{4}-\\d{2}-\\d{2}) by extraction"}},
  {"name": "Quantum-Film", "lane": 1, "row": 0},
  {"name": "Mercenaries2", "lane": 2, "row": 0,
   "note": {"path": "README.md", "pattern": "The public server at `(refesl\\.live)`", "format": "server %s"}},
  {"name": "Merc2-Mods-Exp", "lane": 2, "row": 1}
 ],
 "families": [
  {"label": "mercs2 tools", "lane": 2, "row": 2, "match": "(mercs2-|merc2-|wad-simulator)", "exclude": ["Merc2-Mods-Exp"]}
 ],
 "edges": [
  {"tail": "PrettyCloud", "head": "atlas-darkroom", "kind": "grew-into", "bend": 0,
   "repo": "atlas-darkroom", "path": "README.md",
   "pattern": "^(A print engine for the \\[Atlas of Mathematical Forms\\]\\(https://github\\.com/loganw234/PrettyCloud\\))"},
  {"tail": "PrettyCloud", "head": "atlas-engine", "kind": "grew-into", "bend": 0,
   "repo": "atlas-engine", "path": "README.md", "pattern": "(Sixty-eight plates in PrettyCloud)"},
  {"tail": "atlas-engine", "head": "cft-fp256", "kind": "grew-into", "bend": -16,
   "repo": "cft-fp256", "path": "README.md", "pattern": "(The workload this tile exists to serve is\\s+\\[atlas-engine\\])"},
  {"tail": "atlas-engine", "head": "cft-fp256", "kind": "verified-by", "bend": 16,
   "repo": "cft-fp256", "path": "README.md", "pattern": "(A GPU agrees, bit for bit, on a real workload)"},
  {"tail": "atlas-engine", "head": "atlas-darkroom", "kind": "built-on", "bend": 0,
   "repo": "atlas-darkroom", "path": "README.md", "pattern": "(presentation from PrettyCloud, shape from atlas-engine)"},
  {"tail": "atlas-darkroom", "head": "atlas-optical", "kind": "extracted", "bend": 0,
   "repo": "atlas-optical", "path": "README.md", "pattern": "(Extracted whole from\\s+atlas-darkroom on \\d{4}-\\d{2}-\\d{2})"},
  {"tail": "atlas-darkroom", "head": "atlas-film", "kind": "extracted", "bend": 0,
   "repo": "atlas-film", "path": "README.md", "pattern": "(Born \\d{4}-\\d{2}-\\d{2} by extraction from the darkroom's develop monolith)"},
  {"tail": "cft-fp256", "head": "cft-rebound", "kind": "built-on", "bend": 0,
   "repo": "cft-rebound", "path": "README.md", "pattern": "^(REBOUND's IAS15 integrator with its arithmetic routed through libcft)"},
  {"tail": "cft-fp256", "head": "Quantum-Film", "kind": "built-on", "bend": 0,
   "repo": "Quantum-Film", "path": ".gitmodules", "pattern": "path = (vendor/cft-fp256)"},
  {"tail": "atlas-film", "head": "Quantum-Film", "kind": "built-on", "bend": 0,
   "repo": "Quantum-Film", "path": ".gitmodules", "pattern": "path = (vendor/atlas-film)"},
  {"tail": "cft-fp256", "head": "atlas-film", "kind": "ports", "bend": 66,
   "repo": "ParcelRound", "path": "CASE-STUDY-4.md", "pattern": "(P2 moves atlas-film)"},
  {"tail": "cft-rebound", "head": "ParcelRound", "kind": "distilled-from", "bend": 0,
   "repo": "cft-rebound", "path": "docs/PARCEL-ROUNDS.md", "pattern": "(lifted into a standalone repository)"},
  {"tail": "cft-fp256", "head": "HonestFramework", "kind": "distilled-from", "bend": 0,
   "repo": "HonestFramework", "path": "CASE-STUDY.md", "pattern": "^\\| `(cft-fp256)` \\|"},
  {"tail": "Mercenaries2", "head": "Merc2-Mods-Exp", "kind": "grew-into", "bend": 0,
   "repo": "Mercenaries2", "path": "README.md", "pattern": "visit \\[(Merc2-Mods-Exp)\\]"}
 ]
}
